{
  "name": "grandgridstudio-automation",
  "version": "1.0.0",
  "description": "Playwright-based browser automation for GrandGridStudio marketing ops",
  "type": "module",
  "scripts": {
    "setup": "npx playwright install chromium",
    "morning-sweep": "node tasks/message-sweep.mjs",
    "content-run": "node tasks/content-post.mjs",
    "afternoon-sweep": "node tasks/message-sweep.mjs --check-reminders",
    "night-summary": "node tasks/daily-summary.mjs"
  },
  "dependencies": {
    "playwright": "^1.50.0",
    "@supabase/supabase-js": "^2.45.0"
  }
}
