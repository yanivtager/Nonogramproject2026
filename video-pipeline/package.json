{
  "name": "@grandgridstudio/video-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Short-form marketing video factory for GrandGridStudio nonogram listings. Owns: data model, render pipeline (Remotion), TTS (Edge TTS), validation gate, self-review, Lovable QA gate.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "render": "tsx scripts/render-variant.ts",
    "render:batch": "tsx scripts/render-batch.ts",
    "self-review": "tsx scripts/self-review.ts",
    "lovable-qa": "tsx scripts/lovable-qa.ts",
    "curate:voices": "tsx scripts/curate-voices.ts",
    "curate:music": "tsx scripts/curate-music.ts",
    "upload:artwork": "tsx scripts/upload-artwork.ts",
    "sync:phase0-assets": "tsx scripts/sync-phase0-assets.ts",
    "export:metricool": "tsx scripts/export-metricool-batch.ts",
    "worker:render": "tsx scripts/render-worker.ts",
    "prelovable:check": "tsx scripts/pre-lovable-check.ts",
    "remotion:studio": "remotion studio src/compositions/index.ts",
    "gen:types": "tsx scripts/gen-supabase-types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/captions": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "msedge-tts": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
